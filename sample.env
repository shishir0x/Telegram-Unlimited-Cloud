# Required Variables (Replace placeholders with your real credentials)

API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Tokens: For multiple bots, separate tokens by a comma (no spaces)
# Example: BOT_TOKENS=bot_token_1,bot_token_2,bot_token_3
BOT_TOKENS=1234567890:AAH_your_token_1,9876543210:AAH_your_token_2

# Storage Channel ID (Bot must be an Admin in this channel)
STORAGE_CHANNEL=-1001234567890

# Database backup message ID in the storage channel
DATABASE_BACKUP_MSG_ID=1

# Web Admin Password (used to log into the Google Drive Web UI)
ADMIN_PASSWORD=your_secure_password_here

# Admin email address — OTP codes will be sent here AND this must match on login
ADMIN_EMAIL=your_admin_email@gmail.com

# Session duration in hours (default 12 hours) — stays logged in without re-authenticating
SESSION_HOURS=12

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate_a_random_64_char_hex_string

# Resend API Key (Recommended for Cloud / Render — bypasses SMTP port blocking)
# Create a free key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Settings for OTP delivery (Optional Fallback)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_account@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Optional: Cloud website URL to ping periodically to prevent spin-down
# WEBSITE_URL=https://your-service-name.onrender.com