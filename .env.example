# ==============================================================================
# Telegram Unlimited Cloud - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit your actual '.env' file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Core Application & Telegram Integration)
# ------------------------------------------------------------------------------

# Telegram API credentials from https://my.telegram.org/auth
API_ID=12345678
API_HASH=your_api_hash_hex_string

# Telegram Bot Token(s) for uploading, downloading, and streaming files.
# For high throughput or multi-bot load-balancing, separate multiple tokens with commas (no spaces).
# Format: 1234567890:AAH_token1,9876543210:AAH_token2
BOT_TOKENS=1234567890:AAH_example_bot_token_here

# Telegram Storage Channel ID (Negative integer with -100 prefix for supergroups/channels).
# The bot(s) specified in BOT_TOKENS MUST be added as Administrators with full posting rights.
STORAGE_CHANNEL=-1001234567890

# Message ID of the pinned database backup in the storage channel.
# Create a dummy message in your storage channel and enter its message ID here (e.g. 1).
DATABASE_BACKUP_MSG_ID=1

# Web Admin Password (used to authenticate into the Web UI).
# Must be a strong, non-default password (minimum 8 characters).
ADMIN_PASSWORD=your_strong_admin_password_here

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY CONFIGURATION (Required for Production)
# ------------------------------------------------------------------------------

# Admin email address for One-Time Password (OTP) 2FA verification.
# When logging in via the web interface, OTP codes are sent here and checked.
ADMIN_EMAIL=your_admin_email@example.com

# Session lifetime in hours (default: 12). Defines how long an authenticated web session remains active.
SESSION_HOURS=12

# Secret key used for cryptographic session signing and cookie protection.
# Generate a secure 64-character hex key using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate_a_random_64_char_hex_key_here

# ------------------------------------------------------------------------------
# 3. EMAIL / OTP DELIVERY PROVIDER (Choose either Resend API or SMTP)
# ------------------------------------------------------------------------------

# [Option A - Recommended for Cloud/Render/VPS] Resend API Key (Bypasses SMTP port blocking)
# Create a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# [Option B - Standard SMTP] Gmail / Custom SMTP settings
# For Gmail, generate an App Password at https://myaccount.google.com/apppasswords (requires 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=TG Drive
SMTP_USE_TLS=false

# ------------------------------------------------------------------------------
# 4. OPTIONAL PERFORMANCE & STORAGE EXTENSIONS
# ------------------------------------------------------------------------------

# Pyrogram String Sessions for Telegram Premium accounts.
# Unlocks 4 GB single file upload limits (default standard bot limit is 2 GB).
# Multiple sessions can be comma-separated.
STRING_SESSIONS=

# Database backup interval in seconds (default: 60).
DATABASE_BACKUP_TIME=60

# Telegram FloodWait backoff threshold in seconds (default: 60).
SLEEP_THRESHOLD=60

# Public URL of your deployed application (used by background task to prevent container sleep).
WEBSITE_URL=https://your-app-domain.example.com

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT MODE (Optional Direct Messaging Interface)
# ------------------------------------------------------------------------------

# Main Bot Token for interactive direct-message commands (/start, /drive, /stats).
# Leave empty if you only want the Web UI.
MAIN_BOT_TOKEN=

# Comma-separated list of Telegram User IDs allowed to interact with the bot in Bot Mode.
TELEGRAM_ADMIN_IDS=123456789,987654321
